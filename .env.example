# 10 ERP Web API base URL used by the technician app.
#
# Prefix EXPO_PUBLIC_ => the value is inlined into the JS bundle at build time.
# EAS build profiles also set this (see eas.json). Keep it out of git for real
# environments and prefer `eas env` / EAS secrets for production values.

# Primary host (production API used by the web technician dashboard):
EXPO_PUBLIC_API_BASE_URL=https://erpapi.rentro.ae

# Legacy deployment referenced by public/sign.html in the web repo — use this on
# older deployments by copying this file to `.env.local` and swapping the value:
# EXPO_PUBLIC_API_BASE_URL=https://erpapi.rentro.ae
