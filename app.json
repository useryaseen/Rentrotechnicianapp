{
  "expo": {
    "name": "Rent Ro Tech",
    "slug": "rentro-technician",
    "scheme": "rentrotech",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ae.rentro.technician",
      "infoPlist": {
        "NSCameraUsageDescription": "Capture before/after service photos and signed job cards.",
        "NSPhotoLibraryUsageDescription": "Attach photos to a service report."
      }
    },
    "android": {
      "package": "ae.rentro.technician",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach service photos.",
          "cameraPermission": "Capture service photos.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b637066a-d923-494d-8f3f-e934b593da7c"
      }
    }
  }
}
